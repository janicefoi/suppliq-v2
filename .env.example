# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
# Local Docker dev (port 5435 — see docker-compose.yml):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5435/suppliq_dev"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5435/suppliq_dev"
#
# Production on Supabase — copy BOTH strings from
# Dashboard → Project Settings → Database → Connection string.
#
# DATABASE_URL must be the *transaction pooler* (port 6543). Serverless
# functions open a connection per invocation, and the direct connection
# (port 5432) runs out of slots under any real traffic.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL must be the *direct* connection (port 5432). Prisma uses it for
# `migrate` / `db push`, which need a real session the pooler can't provide.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ============================================================
# AUTH (NextAuth v5)
# ============================================================
# v5 reads AUTH_SECRET. NEXTAUTH_SECRET is the v4 name and is only honoured
# as a fallback — set AUTH_SECRET on every deployment target.
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-here"
#
# AUTH_URL is only needed when the deployment can't infer its own origin.
# Vercel sets VERCEL_URL, so leave AUTH_URL UNSET there — a stale
# "http://localhost:3000" copied into Vercel breaks every callback.
# AUTH_URL="http://localhost:3000"

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_NAME="SUPPLIQ"
# Must be the real deployed origin in production — Stripe redirects back here.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="EUR"
NEXT_PUBLIC_CURRENCY_SYMBOL="€"

# ============================================================
# AI SERVICE (Python FastAPI — run with: uvicorn main:app --port 8000 inside ai/)
# ============================================================
# In production this must point at the deployed FastAPI service. If it is left
# at localhost, every AI insight page degrades to "AI service unavailable".
AI_SERVICE_URL="http://localhost:8000"

# ============================================================
# EMAIL (Resend) — optional; alerts are skipped when unset
# ============================================================
RESEND_API_KEY=""
EMAIL_FROM="Suppliq Alerts <alerts@suppliq.com>"

# ============================================================
# STRIPE
# ============================================================
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_ENTERPRISE_PRICE_ID="price_..."
# Public vars are safe to expose — they're just price IDs
NEXT_PUBLIC_STRIPE_GROWTH_MONTHLY_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_GROWTH_YEARLY_PRICE_ID="price_..."
