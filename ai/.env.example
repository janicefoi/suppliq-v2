# ── Database (same Postgres as Next.js) ───────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/suppliq_dev

# ── Anthropic Claude ──────────────────────────────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-8

# ── Next.js origin (CORS) ─────────────────────────────────────────────────
NEXTJS_ORIGIN=http://localhost:3000

# ── NewsAPI (free tier: 100 req/day) ──────────────────────────────────────
# Register at https://newsapi.org
NEWS_API_KEY=

# ── Alpha Vantage (free tier: 25 req/day) ─────────────────────────────────
# Register at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ── OpenWeatherMap (free tier: 1000 req/day) ──────────────────────────────
# Register at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ── Exchange Rates API (free tier: 250 req/month) ─────────────────────────
# Register at https://exchangeratesapi.io
EXCHANGE_RATES_API_KEY=

# ── Scheduler ─────────────────────────────────────────────────────────────
FORECAST_INTERVAL_MINUTES=60
